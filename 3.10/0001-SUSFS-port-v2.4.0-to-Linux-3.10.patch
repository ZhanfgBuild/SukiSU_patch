+ * strlcpy(); provide a local implementation instead of falling back
+ * to the deprecated helper. */
+static ssize_t susfs_strscpy(char *dest, const char *src, size_t count)
+{
+	size_t len = strlen(src);
+	ssize_t ret = len;
+
+	if (!count)
+		return -E2BIG;
+	if (len >= count) {
+		len = count - 1;
+		ret = -E2BIG;
+	}
+	memcpy(dest, src, len);
+	dest[len] = '\0';
+	return ret;
+}
