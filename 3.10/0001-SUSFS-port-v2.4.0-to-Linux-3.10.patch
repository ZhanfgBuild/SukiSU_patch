 {
@@ -114,7 +118,12 @@ SYSCALL_DEFINE3(ioprio_set, int, which, int, who, int, ioprio)
 			uid = make_kuid(current_user_ns(), who);
 			if (!uid_valid(uid))
 				break;
+#ifdef CONFIG_KSU_SUSFS_PRIORITY_UID_FILTER
+			if (__kuid_val(current_uid()) >= 10000 && susfs_is_priority_uid_filtered(__kuid_val(uid)))
