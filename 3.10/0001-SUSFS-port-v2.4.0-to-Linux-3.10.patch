+static struct filename *susfs_getname_kernel(const char *name)
+{
+	struct filename *result;
+	char *kname;
+	int len = strlen(name) + 1;
+
+	if (len > PATH_MAX)
+		return ERR_PTR(-ENAMETOOLONG);
+
+	result = __getname();
+	if (unlikely(!result))
+		return ERR_PTR(-ENOMEM);
+
+	kname = (char *)result + sizeof(*result);
+	memcpy(kname, name, len);
+	result->name = kname;
+	result->uptr = NULL;
+	result->aname = NULL;
+	result->separate = false;
