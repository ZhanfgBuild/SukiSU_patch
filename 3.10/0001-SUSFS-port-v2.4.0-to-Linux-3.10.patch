diff --git a/fs/ioprio.c b/fs/ioprio.c
index 563435684..1adcffd05 100644
--- a/fs/ioprio.c
+++ b/fs/ioprio.c
@@ -57,6 +57,10 @@ int set_task_ioprio(struct task_struct *task, int ioprio)
